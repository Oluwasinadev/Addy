<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>ProWrite Elite | Author Suite</title>
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@700&family=Inter:wght@300;400;600&family=Lora:ital,wght@0,400;1,400&display=swap" rel="stylesheet">
    <style>
        :root { 
            --pnl: #064e3b; /* Deep Emerald */
            --bg: #fdf6e3;  /* Warm Paper */
            --txt: #1a2e05; /* Dark Forest Text */
            --acc: #fbbf24; /* Amber Gold */
            --paper: #ffffff;
            --btn: #e11d48; /* Rose Crimson */
        }
        .theme-dark { --pnl: #022c22; --bg: #064e3b; --txt: #ecfdf5; --paper: #065f46; }

        * { margin: 0; padding: 0; box-sizing: border-box; }
        body { font-family: 'Inter', sans-serif; background: var(--bg); color: var(--txt); height: 100vh; overflow: hidden; display: flex; flex-direction: column; }
        
        header { height: 60px; background: var(--pnl); display: flex; justify-content: space-between; align-items: center; padding: 0 25px; box-shadow: 0 4px 10px rgba(0,0,0,0.2); }
        .logo { font-family: 'Playfair Display', serif; color: var(--acc); font-size: 1.5rem; }

        .workspace { display: flex; flex: 1; overflow: hidden; }

        /* LEFT SIDE: CHAPTERS */
        .side-l { width: 260px; background: var(--pnl); color: white; padding: 20px; display: flex; flex-direction: column; }
        .list-item { padding: 12px; margin-bottom: 8px; background: rgba(255,255,255,0.05); border-radius: 6px; cursor: pointer; font-size: 14px; transition: 0.3s; }
        .list-item:hover { background: var(--acc); color: var(--pnl); }
        .list-item.active { background: var(--acc); color: var(--pnl); font-weight: bold; }

        /* CENTER: EDITOR */
        .main { flex: 1; overflow-y: auto; padding: 40px; display: flex; flex-direction: column; align-items: center; }
        .paper { width: 100%; max-width: 800px; background: var(--paper); min-height: 1000px; padding: 80px; box-shadow: 0 10px 30px rgba(0,0,0,0.05); border-radius: 4px; }
        .title-in { font-family: 'Playfair Display', serif; font-size: 38px; width: 100%; margin-bottom: 30px; border: none; outline: none; background: transparent; color: var(--txt); }
        .body-in { font-family: 'Lora', serif; font-size: 19px; line-height: 1.9; outline: none; min-height: 600px; }

        /* RIGHT SIDE: THE ARCHIVE */
        .side-r { width: 300px; background: white; border-left: 1px solid #ddd; padding: 20px; overflow-y: auto; }
        .input-group { margin-bottom: 20px; background: #f9f9f9; padding: 15px; border-radius: 8px; border: 1px solid #eee; }
        input, textarea { width: 100%; padding: 8px; margin-bottom: 10px; border: 1px solid #ccc; border-radius: 4px; font-family: 'Inter'; }
        .btn-add { background: var(--btn); color: white; border: none; padding: 8px 12px; border-radius: 4px; cursor: pointer; font-weight: bold; width: 100%; }

        /* IDEA BOX */
        #idea-box { position: absolute; bottom: 20px; left: 280px; width: 320px; background: #1a2e05; color: white; border-radius: 8px; transition: 0.4s; z-index: 100; border: 1px solid var(--acc); }
        .idea-h { padding: 12px; cursor: pointer; display: flex; justify-content: space-between; font-size: 11px; color: var(--acc); font-weight: bold; }
        .idea-c { height: 150px; padding: 15px; }
        .min { transform: translateY(165px); }

        footer { height: 40px; background: var(--pnl); color: white; font-size: 11px; display: flex; align-items: center; padding: 0 20px; }
    </style>
</head>
<body id="b">
    <header>
        <div class="logo">ProWrite Elite</div>
        <div>
            <button onclick="document.getElementById('b').classList.toggle('theme-dark')" style="padding: 5px 10px; cursor:pointer;">Toggle Night Mode</button>
        </div>
    </header>

    <div class="workspace">
        <aside class="side-l">
            <h4 style="font-size: 11px; letter-spacing: 2px; margin-bottom: 15px; opacity: 0.6;">MANUSCRIPT</h4>
            <div id="chapter-list">
                <div class="list-item active" onclick="switchChapter(1)">Chapter 1</div>
            </div>
            <button class="btn-add" onclick="addChapter()" style="margin-top: 10px; background: rgba(255,255,255,0.1);">+ Add Chapter</button>
        </aside>

        <main class="main">
            <div class="paper">
                <input type="text" class="title-in" id="docTitle" value="Chapter 1">
                <div contenteditable="true" class="body-in" id="docBody" oninput="doCount()">Begin your novel here...</div>
            </div>
        </main>

        <aside class="side-r">
            <h4 style="font-size: 11px; letter-spacing: 2px; margin-bottom: 20px; color: #666;">THE ARCHIVE</h4>
            
            <div class="input-group">
                <p style="font-size: 11px; font-weight: bold; margin-bottom: 5px;">ADD CHARACTER</p>
                <input type="text" id="charName" placeholder="Name (e.g. Elena)">
                <textarea id="charBio" placeholder="Notes (Appearance, Goals...)"></textarea>
                <button class="btn-add" onclick="addCharacter()">Save Character</button>
            </div>

            <div id="character-display">
                </div>
        </aside>

        <div id="idea-box" class="min">
            <div class="idea-h" onclick="document.getElementById('idea-box').classList.toggle('min')">
                <span>STORY IDEAS</span> <span>↕</span>
            </div>
            <div class="idea-c">
                <textarea style="background:transparent; border:none; color:white; width:100%; height:100%;" placeholder="Paste ideas here..."></textarea>
            </div>
        </div>
    </div>

    <footer>
        <span id="wc">Words: 0</span> <span style="margin-left:20px;" id="rt">Reading Time: 0 min</span>
    </footer>

    <script>
        // 1. ADD CHARACTER LOGIC
        function addCharacter() {
            let name = document.getElementById('charName').value;
            let bio = document.getElementById('charBio').value;
            if(!name) return;
            
            let display = document.getElementById('character-display');
            let div = document.createElement('div');
            div.style = "background:#f0fdf4; padding:10px; border-radius:6px; margin-bottom:10px; border-left:4px solid #064e3b; font-size:13px;";
            div.innerHTML = `<strong>${name}</strong><br><span style="color:#666">${bio}</span>`;
            display.appendChild(div);

            document.getElementById('charName').value = "";
            document.getElementById('charBio').value = "";
        }

        // 2. CHAPTER LOGIC
        let chapCount = 1;
        function addChapter() {
            chapCount++;
            let list = document.getElementById('chapter-list');
            let div = document.createElement('div');
            div.className = "list-item";
            div.innerText = "Chapter " + chapCount;
            div.onclick = function() {
                document.querySelectorAll('.list-item').forEach(e => e.classList.remove('active'));
                div.classList.add('active');
                document.getElementById('docTitle').value = "Chapter " + chapCount;
                document.getElementById('docBody').innerText = "Start writing chapter " + chapCount + "...";
            };
            list.appendChild(div);
        }

        function switchChapter(num) {
             document.getElementById('docTitle').value = "Chapter " + num;
        }

        // 3. STATS LOGIC
        function doCount() {
            let t = document.getElementById('docBody').innerText.trim();
            let w = t ? t.split(/\s+/).length : 0;
            document.getElementById('wc').innerText = 'Words: ' + w;
            document.getElementById('rt').innerText = 'Reading Time: ' + Math.ceil(w/200) + ' min';
        }
    </script>
</body>
</html>
